{
  "name": "closeloop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Evidence-driven intercompany close with versioned approval and change recovery.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local src/server.js",
    "start": "node --env-file-if-exists=.env.local src/server.js",
    "test": "node --test tests/*.test.js",
    "evaluate": "node scripts/evaluate.js",
    "check": "tsc -p tsconfig.json && node --check public/app.js && node --check public/lab.js",
    "check:traces": "node scripts/check-traces.js",
    "verify:live": "node --env-file-if-exists=.env.local scripts/verify-live.js",
    "verify:failure": "node --env-file-if-exists=.env.local scripts/verify-failure-trace.js"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.44",
    "ai": "^7.0.93",
    "neatlogs": "^1.1.19",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "agent-browser": "^0.27.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "@opentelemetry/otlp-transformer@0.216.0": {
      "protobufjs": "8.8.0"
    },
    "@opentelemetry/sdk-trace-node": {
      "@opentelemetry/propagator-jaeger": "2.11.0"
    }
  }
}
